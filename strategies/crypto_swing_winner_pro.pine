//@version=5
strategy("Crypto Swing Winner Pro", shorttitle="CryptoSwingPro", overlay=true,
         default_qty_type=strategy.percent_of_equity, default_qty_value=30,
         commission_type=strategy.commission.percent, commission_value=0.1,
         pyramiding=2, close_entries_rule="FIFO")

// === SWING TRADING INPUTS (Crypto Optimized) ===
// Multi-Timeframe EMAs
ema_21 = input.int(21, title="EMA 21", group="Moving Averages")
ema_50 = input.int(50, title="EMA 50", group="Moving Averages")
ema_100 = input.int(100, title="EMA 100", group="Moving Averages")
ema_200 = input.int(200, title="EMA 200", group="Moving Averages")

// Ichimoku Cloud (Crypto adaptation)
ichimoku_conversion = input.int(9, title="Conversion Line", group="Ichimoku")
ichimoku_base = input.int(26, title="Base Line", group="Ichimoku")
ichimoku_span = input.int(52, title="Span B", group="Ichimoku")
ichimoku_displacement = input.int(26, title="Displacement", group="Ichimoku")

// Fibonacci Levels
fib_lookback = input.int(50, title="Fibonacci Lookback", group="Fibonacci", minval=20, maxval=100)

// Multi-Oscillator Confluence
rsi_period = input.int(14, title="RSI Period", group="Oscillators")
stoch_k = input.int(14, title="Stochastic %K", group="Oscillators")
stoch_d = input.int(3, title="Stochastic %D", group="Oscillators")
williams_period = input.int(14, title="Williams %R Period", group="Oscillators")

// Volume Profile (Swing levels)
volume_profile_length = input.int(100, title="Volume Profile Length", group="Volume", minval=50, maxval=200)

// Risk Management (Swing optimized)
position_size_pct = input.float(30.0, title="Position Size %", group="Risk Management", minval=10.0, maxval=50.0)
stop_loss_atr = input.float(2.5, title="Stop Loss (ATR multiplier)", group="Risk Management", minval=1.5, maxval=4.0)
take_profit_ratio = input.float(2.5, title="Risk/Reward Ratio", group="Risk Management", minval=1.5, maxval=5.0)
max_drawdown_pct = input.float(15.0, title="Max Drawdown %", group="Risk Management", minval=5.0, maxval=25.0)

// Market Structure
structure_lookback = input.int(20, title="Structure Lookback", group="Market Structure", minval=10, maxval=50)

// === CALCULATIONS ===
// EMAs
ema21 = ta.ema(close, ema_21)
ema50 = ta.ema(close, ema_50)
ema100 = ta.ema(close, ema_100)
ema200 = ta.ema(close, ema_200)

// EMA Alignment (All EMAs in order)
ema_bullish_alignment = ema21 > ema50 and ema50 > ema100 and ema100 > ema200
ema_bearish_alignment = ema21 < ema50 and ema50 < ema100 and ema100 < ema200

// Ichimoku Cloud
conversion_line = (ta.highest(high, ichimoku_conversion) + ta.lowest(low, ichimoku_conversion)) / 2
base_line = (ta.highest(high, ichimoku_base) + ta.lowest(low, ichimoku_base)) / 2
lead_line1 = (conversion_line + base_line) / 2
lead_line2 = (ta.highest(high, ichimoku_span) + ta.lowest(low, ichimoku_span)) / 2

// Cloud color and position
cloud_bullish = lead_line1 > lead_line2
price_above_cloud = close > math.max(lead_line1[ichimoku_displacement], lead_line2[ichimoku_displacement])
price_below_cloud = close < math.min(lead_line1[ichimoku_displacement], lead_line2[ichimoku_displacement])

// Fibonacci Retracement Levels
highest_price = ta.highest(high, fib_lookback)
lowest_price = ta.lowest(low, fib_lookback)
fib_range = highest_price - lowest_price
fib_618 = highest_price - (fib_range * 0.618)
fib_382 = highest_price - (fib_range * 0.382)
fib_236 = highest_price - (fib_range * 0.236)

// Multi-Oscillator Analysis
rsi = ta.rsi(close, rsi_period)
k_percent = ta.stoch(close, high, low, stoch_k)
d_percent = ta.sma(k_percent, stoch_d)
williams_r = ta.wpr(williams_period) * -1

// Oscillator Confluence
oscillators_oversold = rsi < 35 and k_percent < 25 and williams_r < 25
oscillators_overbought = rsi > 65 and k_percent > 75 and williams_r > 75
oscillators_bullish_divergence = rsi > rsi[5] and close < close[5] and rsi < 50

// ATR for dynamic stops
atr = ta.atr(14)

// Volume Analysis (Accumulation/Distribution)
ad_line = ta.accdist
ad_ema = ta.ema(ad_line, 21)
volume_accumulation = ad_line > ad_ema and volume > ta.sma(volume, 20)

// Market Structure (Higher Highs/Lower Lows)
higher_high = high > ta.highest(high[1], structure_lookback)
lower_low = low < ta.lowest(low[1], structure_lookback)
market_structure_bullish = higher_high and not lower_low
market_structure_bearish = lower_low and not higher_high

// Support/Resistance Levels
resistance_level = ta.highest(high, 50)
support_level = ta.lowest(low, 50)
near_support = close <= support_level * 1.02 and close >= support_level * 0.98
near_resistance = close >= resistance_level * 0.98 and close <= resistance_level * 1.02

// === ADVANCED ENTRY CONDITIONS ===
// Long Setup: Maximum Confluence
long_trend_alignment = ema_bullish_alignment and price_above_cloud
long_retracement_buy = close <= fib_618 and close >= fib_382 and close > ema50
long_oscillator_setup = oscillators_oversold or oscillators_bullish_divergence
long_volume_confirm = volume_accumulation
long_structure_confirm = market_structure_bullish or near_support
long_momentum = ta.crossover(rsi, 50) or ta.crossover(k_percent, d_percent)

long_condition = long_trend_alignment and long_retracement_buy and long_oscillator_setup and long_volume_confirm and long_structure_confirm and long_momentum and strategy.position_size >= 0

// Short Setup: Maximum Confluence
short_trend_alignment = ema_bearish_alignment and price_below_cloud
short_retracement_sell = close >= fib_382 and close <= fib_618 and close < ema50
short_oscillator_setup = oscillators_overbought
short_volume_confirm = not volume_accumulation and volume > ta.sma(volume, 20)
short_structure_confirm = market_structure_bearish or near_resistance
short_momentum = ta.crossunder(rsi, 50) or ta.crossunder(k_percent, d_percent)

short_condition = short_trend_alignment and short_retracement_sell and short_oscillator_setup and short_volume_confirm and short_structure_confirm and short_momentum and strategy.position_size <= 0

// === PYRAMID CONDITIONS ===
// Add to winning positions on pullbacks
long_add_condition = strategy.position_size > 0 and close > strategy.position_avg_price * 1.02 and close < ema21 and rsi < 60 and strategy.opentrades < 2

short_add_condition = strategy.position_size < 0 and close < strategy.position_avg_price * 0.98 and close > ema21 and rsi > 40 and strategy.opentrades < 2

// === POSITION MANAGEMENT ===
// Calculate position size based on ATR
long_stop_distance = atr * stop_loss_atr
short_stop_distance = atr * stop_loss_atr
position_risk = (strategy.equity * position_size_pct / 100)

// Entry Orders
if long_condition
    qty = position_risk / long_stop_distance
    strategy.entry("Long1", strategy.long, qty=qty, alert_message="🎯 SWING LONG ENTRY: High Confluence Setup")

if short_condition
    qty = position_risk / short_stop_distance  
    strategy.entry("Short1", strategy.short, qty=qty, alert_message="🎯 SWING SHORT ENTRY: High Confluence Setup")

// Pyramid Entries
if long_add_condition
    qty = (position_risk * 0.5) / long_stop_distance
    strategy.entry("Long2", strategy.long, qty=qty, alert_message="📈 LONG ADD: Pullback Entry")

if short_add_condition
    qty = (position_risk * 0.5) / short_stop_distance
    strategy.entry("Short2", strategy.short, qty=qty, alert_message="📉 SHORT ADD: Pullback Entry")

// Dynamic Exit Conditions
long_profit_taking = strategy.position_size > 0 and (rsi > 75 or close >= resistance_level)
short_profit_taking = strategy.position_size < 0 and (rsi < 25 or close <= support_level)

if long_profit_taking
    strategy.close("Long1", qty_percent=50, alert_message="💰 LONG PROFIT: Taking Partial")
    strategy.close("Long2", qty_percent=50, alert_message="💰 LONG PROFIT: Taking Partial")

if short_profit_taking
    strategy.close("Short1", qty_percent=50, alert_message="💰 SHORT PROFIT: Taking Partial")
    strategy.close("Short2", qty_percent=50, alert_message="💰 SHORT PROFIT: Taking Partial")

// Stop Loss & Take Profit Management
if strategy.position_size > 0
    stop_price = strategy.position_avg_price - (atr * stop_loss_atr)
    target_price = strategy.position_avg_price + (atr * stop_loss_atr * take_profit_ratio)
    strategy.exit("Long Exit", from_entry="Long1", stop=stop_price, limit=target_price)
    strategy.exit("Long Add Exit", from_entry="Long2", stop=stop_price, limit=target_price)

if strategy.position_size < 0
    stop_price = strategy.position_avg_price + (atr * stop_loss_atr)
    target_price = strategy.position_avg_price - (atr * stop_loss_atr * take_profit_ratio)
    strategy.exit("Short Exit", from_entry="Short1", stop=stop_price, limit=target_price)
    strategy.exit("Short Add Exit", from_entry="Short2", stop=stop_price, limit=target_price)

// === PLOTTING ===
// EMA Cloud
plot(ema21, color=color.new(color.blue, 0), linewidth=2, title="EMA 21")
plot(ema50, color=color.new(color.orange, 0), linewidth=2, title="EMA 50")
plot(ema100, color=color.new(color.yellow, 30), linewidth=1, title="EMA 100")
plot(ema200, color=color.new(color.red, 30), linewidth=1, title="EMA 200")

// Ichimoku Cloud
p1 = plot(lead_line1[ichimoku_displacement], color=color.new(color.green, 70), title="Lead 1")
p2 = plot(lead_line2[ichimoku_displacement], color=color.new(color.red, 70), title="Lead 2")
fill(p1, p2, color=cloud_bullish ? color.new(color.green, 90) : color.new(color.red, 90))

// Fibonacci Levels (only when relevant)
plot(near_support or near_resistance ? fib_618 : na, color=color.new(color.purple, 50), 
     style=plot.style_line, linewidth=1, title="Fib 61.8%")
plot(near_support or near_resistance ? fib_382 : na, color=color.new(color.purple, 70), 
     style=plot.style_line, linewidth=1, title="Fib 38.2%")

// Entry Signals
plotshape(long_condition, style=shape.triangleup, location=location.belowbar, 
          color=color.new(color.lime, 0), size=size.large, title="Swing Long")
plotshape(short_condition, style=shape.triangledown, location=location.abovebar, 
          color=color.new(color.red, 0), size=size.large, title="Swing Short")

// Add signals
plotshape(long_add_condition, style=shape.circle, location=location.belowbar, 
          color=color.new(color.aqua, 0), size=size.small, title="Long Add")
plotshape(short_add_condition, style=shape.circle, location=location.abovebar, 
          color=color.new(color.fuchsia, 0), size=size.small, title="Short Add")

// === STRATEGY PERFORMANCE TABLE ===
if barstate.islast
    var table strategy_table = table.new(position.top_left, 4, 10, bgcolor=color.new(color.white, 80), border_width=1)
    
    // Headers
    table.cell(strategy_table, 0, 0, "CRYPTO SWING PRO", text_color=color.white, bgcolor=color.new(color.blue, 0), text_size=size.normal)
    table.cell(strategy_table, 1, 0, "Value", text_color=color.white, bgcolor=color.new(color.blue, 0))
    table.cell(strategy_table, 2, 0, "Signal", text_color=color.white, bgcolor=color.new(color.blue, 0))
    table.cell(strategy_table, 3, 0, "Status", text_color=color.white, bgcolor=color.new(color.blue, 0))
    
    // Market Analysis
    table.cell(strategy_table, 0, 1, "Trend", text_color=color.black)
    trend_text = ema_bullish_alignment ? "BULLISH" : ema_bearish_alignment ? "BEARISH" : "SIDEWAYS"
    trend_color = ema_bullish_alignment ? color.green : ema_bearish_alignment ? color.red : color.gray
    table.cell(strategy_table, 1, 1, trend_text, text_color=color.white, bgcolor=trend_color)
    
    table.cell(strategy_table, 0, 2, "Cloud", text_color=color.black)
    cloud_text = price_above_cloud ? "ABOVE" : price_below_cloud ? "BELOW" : "IN CLOUD"
    cloud_color = price_above_cloud ? color.green : price_below_cloud ? color.red : color.orange
    table.cell(strategy_table, 1, 2, cloud_text, text_color=color.white, bgcolor=cloud_color)
    
    table.cell(strategy_table, 0, 3, "RSI", text_color=color.black)
    table.cell(strategy_table, 1, 3, str.tostring(rsi, "#.#"), text_color=color.black)
    rsi_signal = rsi > 65 ? "OB" : rsi < 35 ? "OS" : "NEUTRAL"
    rsi_color = rsi > 65 ? color.red : rsi < 35 ? color.green : color.gray
    table.cell(strategy_table, 2, 3, rsi_signal, text_color=color.white, bgcolor=rsi_color)
    
    table.cell(strategy_table, 0, 4, "Volume", text_color=color.black)
    vol_signal = volume_accumulation ? "ACCUM" : "DISTRIB"
    vol_color = volume_accumulation ? color.green : color.red
    table.cell(strategy_table, 1, 4, vol_signal, text_color=color.white, bgcolor=vol_color)
    
    // Position Info
    table.cell(strategy_table, 0, 5, "Position", text_color=color.black)
    pos_text = strategy.position_size == 0 ? "FLAT" : strategy.position_size > 0 ? "LONG" : "SHORT"
    pos_color = strategy.position_size == 0 ? color.gray : strategy.position_size > 0 ? color.green : color.red
    table.cell(strategy_table, 1, 5, pos_text, text_color=color.white, bgcolor=pos_color)
    
    if strategy.position_size != 0
        table.cell(strategy_table, 0, 6, "Entry", text_color=color.black)
        table.cell(strategy_table, 1, 6, str.tostring(strategy.position_avg_price, "#.####"), text_color=color.black)
        
        table.cell(strategy_table, 0, 7, "P&L", text_color=color.black)
        unrealized_pnl = (close - strategy.position_avg_price) / strategy.position_avg_price * 100 * math.sign(strategy.position_size)
        pnl_color = unrealized_pnl > 0 ? color.green : color.red
        table.cell(strategy_table, 1, 7, str.tostring(unrealized_pnl, "#.##") + "%", text_color=color.white, bgcolor=pnl_color)

// === ADVANCED ALERTS ===
alertcondition(long_condition, title="Swing Long Entry", 
              message="🎯 CRYPTO SWING LONG: {{ticker}} | Price: {{close}} | High Confluence Setup")

alertcondition(short_condition, title="Swing Short Entry", 
              message="🎯 CRYPTO SWING SHORT: {{ticker}} | Price: {{close}} | High Confluence Setup")

alertcondition(long_add_condition, title="Long Add Signal", 
              message="📈 ADD TO LONG: {{ticker}} | Pullback opportunity at {{close}}")

alertcondition(short_add_condition, title="Short Add Signal", 
              message="📉 ADD TO SHORT: {{ticker}} | Pullback opportunity at {{close}}")

alertcondition(long_profit_taking or short_profit_taking, title="Profit Taking Signal", 
              message="💰 PROFIT ZONE: {{ticker}} | Consider taking profits at {{close}}")
